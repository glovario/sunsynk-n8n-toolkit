# Copy to .env (never commit it) and load into n8n's environment.
# --- n8n prerequisites (set on the n8n process, and on the task runner if you use external runners) ---
N8N_BLOCK_ENV_ACCESS_IN_NODE=false      # Code nodes must be able to read these settings
NODE_FUNCTION_ALLOW_BUILTIN=crypto      # Sunsynk Login needs Node's crypto module (add to any existing list, comma-separated)

# --- Sunsynk (secrets) ---
SUNSYNK_USERNAME=you@example.com
SUNSYNK_PASSWORD=change-me
SUNSYNK_API_HOST=api.sunsynk.net        # or pv.inteless.com for Deye/Inteless accounts
SUNSYNK_INVERTER_SN=0000000000          # your inverter serial (Sunsynk app > Device > About)

# --- Safety switches (leave as-is until you have watched dry runs) ---
SUNSYNK_WRITES_ENABLED=false
GUARD_DRY_RUN=true
SELL_DRY_RUN=true
SELL_ENABLED=false
SELL_WRITE_ENABLE_FLAG=false

# --- Sunsynk Control webhook protection ---
SUNSYNK_CONTROL_URL=http://127.0.0.1:5678/webhook/sunsynk-control
SUNSYNK_CONTROL_HEADER_NAME=X-Control-Key
SUNSYNK_CONTROL_HEADER_VALUE=change-me-long-random-string

# --- Octopus (secrets) ---
OCTOPUS_API_KEY=sk_live_change-me
OCTOPUS_ACCOUNT=A-00000000
OCTOPUS_EV_DEVICE_ID=                    # blank = first EV/charger on the account

# --- Guard ---
GUARD_TIMEZONE=Europe/London
GUARD_SLOT=5
GUARD_PROTECTED_SLOTS=1,2,3,4,6
GUARD_CAP_SOC=100
GUARD_RESTORE_START=16:00                # start of the guard slot when not armed; must differ from SELL_START and sit between its neighbours
GUARD_RESTORE_CAP_SOC=50
GUARD_RESTORE_GRID_CHARGE=false
GUARD_OFFPEAK_START=23:30
GUARD_OFFPEAK_END=05:30
GUARD_PLUG_STATE_URL=                    # optional, e.g. http://homeassistant.local:8123/api/states/binary_sensor.car_plugged_in
GUARD_PLUG_ON_STATES=on,plugged_in,true
HA_TOKEN=                                # only if you use the plug gate
GUARD_ALERT_WORKFLOW_ID=                 # optional: n8n workflow ID to call when Octopus fails; blank = no alert
GUARD_LEAD_IN_MIN=20                     # arm at most 20 min before an extra dispatch; later/tomorrow ones wait
GUARD_SLOT_PREV_START=                   # start time of the previous slot (slot 6 if GUARD_SLOT=1); required before GUARD_DRY_RUN=false
GUARD_SLOT_NEXT_START=                   # start time of the next slot (slot 1 if GUARD_SLOT=6); must equal SELL_START if SELL_SLOT is the next slot
OCTOPUS_RETRIES=3
OCTOPUS_RETRY_DELAY_MS=2000

# --- Evening Sell ---
SELL_SLOT=6
SELL_START=18:00
SELL_FLOOR_SOC=50
